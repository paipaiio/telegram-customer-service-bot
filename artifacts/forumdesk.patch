+</tr>
+<tr>
+<td><code class="notranslate">/clear</code> + <code class="notranslate">/clear confirm</code></td>
+<td>Clear both sides while keeping the topic and profile card</td>
+</tr>
+<tr>
+<td><code class="notranslate">/clear_user</code> + <code class="notranslate">/clear_user confirm</code></td>
+<td>Clear only the customer side</td>
+</tr>
+<tr>
+<td><code class="notranslate">/allow_staff</code></td>
+<td>Reply to a member and allow automatic publishing in this topic</td>
+</tr>
+<tr>
+<td><code class="notranslate">/deny_staff</code></td>
+<td>Revoke that member's automatic publishing permission in this topic</td>
+</tr>
+<tr>
+<td><code class="notranslate">/staff</code></td>
+<td>List approved members in this topic</td>
+</tr>
+<tr>
+<td><code class="notranslate">/show</code></td>
+<td>Reply to an internal message and publish it</td>
+</tr>
+<tr>
+<td><code class="notranslate">/hide</code></td>
+<td>Reply to a published message and make it internal</td>
+</tr>
+<tr>
+<td><code class="notranslate">/help</code></td>
+<td>Show the full command reference</td>
+</tr>
