+  `${BASE}/api/v1/conversations/${conversationId}/messages?after=${cursor}&limit=50`,
+  { headers: { "Authorization": `Bearer ${visitorToken}` } }
+);
+const payload = await response.json();
+cursor = payload.meta.next_cursor;</pre></div><p><code>direction</code> 为 <code>customer</code> 或 <code>staff</code>；<code>reply_to_message_id</code> 指向被引用的可见消息。当管理员隐藏已发消息时，队列返回 <code>event: message_hidden</code> 与 <code>target_message_id</code>，前端据此移除已渲染消息。</p></div></section>
+
+    <section id="visibility"><h2>Telegram 成员可见性</h2><div class="card"><table><tr><th>命令</th><th>作用</th></tr><tr><td><code>/allow_staff</code></td><td>管理员回复成员消息，允许其后续发言自动对客可见</td></tr><tr><td><code>/deny_staff</code></td><td>取消该成员在当前 Topic 的自动对客可见</td></tr><tr><td><code>/staff</code></td><td>查看当前 Topic 的授权成员</td></tr><tr><td><code>/show</code></td><td>回复某条内部消息，单独对客可见</td></tr><tr><td><code>/hide</code></td><td>回复某条已发消息，改为仅管理端可见</td></tr></table><p class="note">群管理员发言默认对客可见；普通成员默认只留在 Topic 内部。授权按 Topic 隔离；管理员和已授权成员在 Topic 内使用 Telegram 原生回复时，网页端也能取得引用消息 ID。</p><p class="note">这些命令控制消息是否外发给客户；成员能看到哪些 Topic 仍由 Telegram 超级群本身的成员与权限配置决定。</p></div></section>
