+		"message":  {&memoryStore{conversations: map[string]bot.Conversation{}, addErr: errors.New("write")}, &fakeTelegram{}},
+		"mapping":  {&memoryStore{conversations: map[string]bot.Conversation{}, linkErr: errors.New("write")}, &fakeTelegram{}},
+	} {
