+const labels={"copy":"复制","copied":"已复制"};
+const doc=document.getElementById('doc'),toc=document.getElementById('toc'),tabs=document.getElementById('tabs');
+const slug=(s,i)=>'section-'+(i+1)+'-'+s.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff]+/g,'-').replace(/^-|-$/g,'');
